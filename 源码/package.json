{
  "name": "dental-clinic-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ADC 牙科连锁诊所管理系统",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"nodemon src/server/index.js\" \"vite --config src/web/vite.config.js\"",
    "build": "vite build --config src/web/vite.config.js",
    "start": "node src/server/index.js",
    "db:seed": "node src/server/scripts/seed.js",
    "db:reset-test": "node src/server/scripts/reset-test-db.js",
    "test": "node src/server/scripts/reset-test-db.js && cross-env DB_DATABASE=dental_clinic_test NODE_ENV=test vitest run",
    "test:watch": "cross-env DB_DATABASE=dental_clinic_test NODE_ENV=test vitest",
    "test:ui": "node src/server/scripts/ui-smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "puppeteer-core": "^21.11.0",
    "supertest": "^6.3.4",
    "vite": "^4.5.5",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=16.20"
  }
}
